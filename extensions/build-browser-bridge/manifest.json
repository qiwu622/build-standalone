{
  "manifest_version": 3,
  "name": "Build 连接器 · 酒馆分流",
  "version": "0.5.0",
  "description": "自动连接专用 Build 项目，内置酒馆预设分流：预设进输入框，历史和世界书进项目文件。",
  "minimum_chrome_version": "118",
  "permissions": [
    "debugger",
    "activeTab",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://aistudio.google.com/*",
    "https://ai.studio/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["sillytavern-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "admin-connector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://aistudio.google.com/*",
        "https://ai.studio/*"
      ],
      "js": [
        "page-reader.js",
        "google-onboarding.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "连接专用 Build 项目"
  }
}
