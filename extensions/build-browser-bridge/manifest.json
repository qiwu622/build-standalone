{
  "manifest_version": 3,
  "name": "Build 本机连接器",
  "version": "0.3.0",
  "description": "在正常登录后，将手动选中的专用 Google Build 标签页连接到本机 Build Standalone。",
  "minimum_chrome_version": "118",
  "permissions": ["debugger", "activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "连接专用 Build 项目"}
}
