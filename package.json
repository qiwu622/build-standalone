{
  "name": "build-standalone",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "description": "Single-process Google AI Studio Build text gateway",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/main.mjs",
    "start:background": "node scripts/control.mjs start",
    "stop": "node scripts/control.mjs stop",
    "status": "node scripts/control.mjs status",
    "login": "node scripts/login.mjs",
    "demo": "node src/main.mjs --demo",
    "test": "node --test tests/*.test.mjs",
    "init": "node src/main.mjs --init",
    "install:browser": "node scripts/install-browser.mjs"
  },
  "dependencies": {
    "playwright": "1.64.1"
  }
}
